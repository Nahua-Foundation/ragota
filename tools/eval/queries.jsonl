# --- cross-repository: two checkouts, one contract ------------------------
#
# conductor's es6-persistence module is a client of elasticsearch's rest api,
# and those are two separate checkouts in this corpus. It is the only genuine
# cross-repository contract join the corpus contains, which is itself worth
# recording: every other question above is a service talking to a service
# inside its own repository.
{"id": "xrepo-cluster-health-route", "repo": "elasticsearch", "repos": "all", "shape": "route", "scope": "cross-repo", "query": "which repository serves the GET /_cluster/health endpoint", "expect_file": "server/src/main/java/org/elasticsearch/rest/action/admin/cluster/RestClusterHealthAction.java", "expect_symbol": "prepareRequest", "expect_line": 57, "anchor": "public RestChannelConsumer prepareRequest(final RestRequest request, final NodeClient client)", "alt_files": [], "expect_related": ["conductor:es6-persistence/src/main/java/com/netflix/conductor/es6/dao/index/ElasticSearchRestDAOV6.java"], "why": "The route is bound at RestClusterHealthAction.java:43 and served by prepareRequest at :57; the caller lives in another checkout, conductor's es6-persistence/src/main/java/com/netflix/conductor/es6/dao/index/ElasticSearchRestDAOV6.java:338. Asked with no repository filter at all, so the answer has to be found across everything the run indexed."}
{"id": "xrepo-cluster-health-caller", "repo": "conductor", "repos": ["conductor", "elasticsearch"], "shape": "callers", "scope": "cross-repo", "query": "which service waits for the elasticsearch cluster health endpoint before it starts indexing", "expect_file": "es6-persistence/src/main/java/com/netflix/conductor/es6/dao/index/ElasticSearchRestDAOV6.java", "expect_symbol": "waitForHealthyCluster", "expect_line": 338, "anchor": "elasticSearchAdminClient.performRequest(\"GET\", \"/_cluster/health\", params);", "alt_files": [], "expect_related": ["elasticsearch:server/src/main/java/org/elasticsearch/rest/action/admin/cluster/RestClusterHealthAction.java"], "why": "ElasticSearchRestDAOV6.java:333 defines waitForHealthyCluster and :338 issues the request; the handler is in the other checkout at elasticsearch server/src/main/java/org/elasticsearch/rest/action/admin/cluster/RestClusterHealthAction.java:43. The only other caller of that path in the whole corpus is elasticsearch's own bundled cli, x-pack/plugin/security/src/main/java/org/elasticsearch/xpack/security/authc/esnative/tool/SetupPasswordTool.java:473, which sets passwords rather than indexing anything."}
{"id": "xrepo-index-template-route", "repo": "elasticsearch", "repos": ["conductor", "elasticsearch"], "shape": "route", "scope": "cross-repo", "query": "where does the PUT /_template/{name} request that creates a legacy index template get handled", "expect_file": "server/src/main/java/org/elasticsearch/rest/action/admin/indices/RestPutIndexTemplateAction.java", "expect_symbol": "prepareRequest", "expect_line": 47, "anchor": "public RestChannelConsumer prepareRequest(final RestRequest request, final NodeClient client)", "alt_files": [], "expect_related": ["conductor:es6-persistence/src/main/java/com/netflix/conductor/es6/dao/index/ElasticSearchRestDAOV6.java"], "why": "RestPutIndexTemplateAction.java:34-39 binds POST and PUT /_template/{name} and prepareRequest at :47 serves them; conductor uploads its own templates there from the other checkout at ElasticSearchRestDAOV6.java:275. RestPutComposableIndexTemplateAction next to it serves /_index_template/{name}, which is a different path."}
{"id": "xrepo-index-template-caller", "repo": "conductor", "repos": ["conductor", "elasticsearch"], "shape": "callers", "scope": "cross-repo", "query": "which code uploads an index template to elasticsearch when it does not already exist", "expect_file": "es6-persistence/src/main/java/com/netflix/conductor/es6/dao/index/ElasticSearchRestDAOV6.java", "expect_symbol": "initIndexTemplate", "expect_line": 275, "anchor": "HttpMethod.PUT, \"/_template/\" + template, Collections.emptyMap(), entity);", "alt_files": [], "expect_related": ["elasticsearch:server/src/main/java/org/elasticsearch/rest/action/admin/indices/RestPutIndexTemplateAction.java"], "why": "initIndexTemplate at ElasticSearchRestDAOV6.java:263 checks doesResourceNotExist(\"/_template/\" + template) at :266 and PUTs it at :274-275. The path is concatenated from a prefix and a variable, so no literal route key exists on the calling side; the serving handler is in the other checkout at RestPutIndexTemplateAction.java:47."}
