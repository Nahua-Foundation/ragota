# opencode agent
.opencode/

# .NET design-time build output (written next to .csproj files by the LSP
# csharp container's MSBuild during project load) — scoped to testdata so a
# legitimate top-level bin/ would not be hidden by accident.
testdata/**/obj/
testdata/**/bin/

# Python bytecode from the corpus tooling
__pycache__/
*.pyc

# Benchmark corpus checkouts (make corpus-clone, CORPUS_DIR). Other people's
# source, tens of gigabytes, and named with a leading underscore so the go tool
# skips it when expanding "./..." — see CORPUS_DIR in the Makefile.
/_corpus/

# ragota v1 runtime data (the old local tool wrote its index here)
/.ragota/
